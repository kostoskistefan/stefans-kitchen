---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

type Props = { images: ImageMetadata[]; title: string };
const { images, title } = Astro.props;
const hasMultipleImages = images.length > 1;
---
<div class:list={['gallery', { single: !hasMultipleImages }]} data-gallery>
  <ul class="track" data-gallery-track>
    {images.map((image, index) => (
      <li class="slide">
        <Image
          src={image}
          alt={`${title}, photo ${index + 1}`}
          widths={[480, 960, 1600]}
          sizes="(min-width: 72rem) 66rem, 100vw"
          loading={index === 0 ? 'eager' : 'lazy'}
        />
      </li>
    ))}
  </ul>
  {hasMultipleImages && (
    <>
      <span class="swipe-hint" aria-hidden="true">
        Swipe for more <span class="swipe-hint-arrow">→</span>
      </span>
      <button type="button" class="arrow previous" data-gallery-previous aria-label="Previous photo">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 5-7 7 7 7" /></svg>
      </button>
      <button type="button" class="arrow next" data-gallery-next aria-label="Next photo">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg>
      </button>
    </>
  )}
</div>
<script>
  import '../scripts/gallery-arrows';
</script>
<style>
  .gallery {
    --gallery-height: clamp(16rem, 60vh, 34rem);
    position: relative;
  }
  .track {
    display: flex;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .track::-webkit-scrollbar { display: none; }
  .slide {
    flex: 0 0 auto;
    max-width: 100%;
    height: var(--gallery-height);
    overflow: hidden;
    scroll-snap-align: start;
    background: var(--accent-soft);
    border-radius: 1.5rem;
  }
  .slide:first-child { margin-left: auto; }
  .slide:last-child { margin-right: auto; }
  .slide :global(img) {
    display: block;
    width: auto;
    max-width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .gallery.single .slide {
    flex-basis: 100%;
    height: auto;
    background: transparent;
  }
  .gallery.single .slide :global(img) {
    width: 100%;
    height: auto;
    object-fit: initial;
  }
  .arrow {
    position: absolute;
    top: 50%;
    display: none;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 50%;
    box-shadow: var(--shadow);
    cursor: pointer;
    transform: translateY(-50%);
  }
  .arrow:hover { background: var(--accent); color: var(--accent-contrast); border-color: var(--accent); }
  .swipe-hint {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.75rem;
    color: var(--text);
    background: color-mix(in srgb, var(--surface) 92%, transparent);
    border: 1px solid var(--line);
    border-radius: 999px;
    box-shadow: var(--shadow);
    font-size: 0.8rem;
    font-weight: 600;
    pointer-events: none;
  }
  .swipe-hint-arrow { color: var(--accent); font-size: 1rem; line-height: 1; }
  .previous { left: 1rem; }
  .next { right: 1rem; }
  @media (min-width: 48rem) {
    .swipe-hint { display: none; }
    .gallery[data-overflowing='true'] .arrow { display: grid; }
  }
</style>
